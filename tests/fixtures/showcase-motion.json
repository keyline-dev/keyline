{
 "create": {
  "width": 1080,
  "height": 1080,
  "sizes": [
   {
    "id": "square",
    "width": 1080,
    "height": 1080
   }
  ],
  "duration": 5,
  "fps": 25,
  "loop": true
 },
 "add": {
  "tokens": {
   "violet": "#5B21B6",
   "ink": "#2E0A4F"
  },
  "layers": [
   {
    "id": "bg",
    "type": "rect",
    "width": "fill",
    "height": "fill",
    "fills": [
     {
      "gradient": {
       "angle": 150,
       "stops": [
        "#F97316",
        "#E11D48",
        "#6D28D9"
       ]
      }
     }
    ]
   },
   {
    "id": "blob1",
    "type": "path",
    "shape": "blob-2",
    "width": 620,
    "height": 620,
    "place": "top-right",
    "inset": [
     -160,
     -180
    ],
    "fills": "#FFFFFF1A"
   },
   {
    "id": "blob2",
    "type": "path",
    "shape": "blob-5",
    "width": 520,
    "height": 520,
    "place": "bottom-left",
    "inset": [
     -170,
     -150
    ],
    "fills": "#FFFFFF12"
   },
   {
    "id": "dots",
    "type": "rect",
    "width": 260,
    "height": 180,
    "place": "bottom-right",
    "inset": [
     70,
     90
    ],
    "fills": {
     "pattern": "dots",
     "color": "#FFFFFF44",
     "size": 22
    },
    "in": {
     "effect": "fade",
     "at": 1.8,
     "duration": 0.8
    }
   },
   {
    "id": "hero",
    "type": "frame",
    "clip": false,
    "width": 520,
    "height": 520,
    "hidden": true,
    "children": [
     {
      "type": "ellipse",
      "width": "fill",
      "height": "fill",
      "fills": [
       {
        "gradient": {
         "type": "radial",
         "stops": [
          "#FFFFFF40",
          "#FFFFFF08"
         ]
        }
       }
      ]
     },
     {
      "type": "ellipse",
      "width": "fill",
      "height": "fill",
      "strokes": {
       "width": 3,
       "color": "#FFFFFF55",
       "dash": [
        10,
        14
       ],
       "cap": "round"
      },
      "scale": 0.86
     },
     {
      "type": "icon",
      "name": "cup-soda",
      "color": "#FFFFFF",
      "width": "56%",
      "height": "56%",
      "place": "center",
      "rotation": -8,
      "shadows": {
       "y": 16,
       "blur": 40,
       "color": "#2E0A4F66"
      }
     }
    ]
   },
   {
    "id": "content",
    "type": "frame",
    "clip": false,
    "width": "fill",
    "height": "fill",
    "stack": {
     "dir": "column",
     "gap": 34,
     "padding": 96,
     "justify": "center"
    },
    "children": [
     {
      "id": "eyebrow",
      "type": "frame",
      "fills": "#2E0A4F55",
      "radius": "full",
      "stack": {
       "dir": "row",
       "gap": 12,
       "padding": [
        12,
        26
       ],
       "align": "center"
      },
      "children": [
       {
        "type": "icon",
        "name": "sparkles",
        "color": "#FFFFFF",
        "width": 30,
        "height": 30
       },
       {
        "type": "text",
        "text": "NEW \u00b7 SUMMER DROP",
        "fontSize": 26,
        "weight": 800,
        "letterSpacing": 3,
        "color": "#FFFFFF",
        "trim": "cap"
       }
      ],
      "in": {
       "effect": "fade-down",
       "at": 0.1,
       "duration": 0.5,
       "distance": 24
      }
     },
     {
      "id": "headline",
      "type": "text",
      "text": "Cold Brew<br>Season",
      "fontSize": 168,
      "weight": 900,
      "lineHeight": 0.92,
      "color": "#FFFFFF",
      "width": "fill",
      "shadows": {
       "y": 8,
       "blur": 30,
       "color": "#2E0A4F55"
      },
      "split": "chars",
      "stagger": 0.035,
      "animate": {
       "offset": {
        "from": [
         "random(-40, 40)",
         "random(90, 170)"
        ]
       },
       "rotation": {
        "from": "random(-30, 30)"
       },
       "scale": {
        "from": 0.5
       },
       "opacity": {
        "from": 0
       },
       "at": 0.3,
       "duration": 0.8,
       "ease": "back.out"
      }
     },
     {
      "id": "sub",
      "type": "text",
      "text": "Steeped for 18 hours. <b>Smooth, bold, never bitter.</b>",
      "fontSize": 38,
      "color": "#FFFFFF",
      "width": "fill",
      "maxWidth": 760,
      "split": "words",
      "stagger": 0.05,
      "in": {
       "effect": "fade-up",
       "at": 1.2,
       "duration": 0.5,
       "distance": 20
      }
     },
     {
      "id": "cta-row",
      "type": "frame",
      "clip": false,
      "stack": {
       "dir": "row",
       "gap": 28,
       "align": "center"
      },
      "children": [
       {
        "id": "cta",
        "type": "frame",
        "fills": "#FFFFFF",
        "radius": "full",
        "shadows": {
         "y": 12,
         "blur": 30,
         "color": "#2E0A4F44"
        },
        "stack": {
         "dir": "row",
         "gap": 14,
         "padding": [
          24,
          44
         ],
         "align": "center"
        },
        "children": [
         {
          "type": "text",
          "text": "Order now",
          "fontSize": 36,
          "weight": 800,
          "color": "$violet",
          "trim": "cap"
         },
         {
          "type": "icon",
          "name": "arrow-right",
          "color": "$violet",
          "width": 36,
          "height": 36
         }
        ],
        "in": {
         "effect": "pop",
         "at": 1.7,
         "duration": 0.5
        },
        "animate": {
         "scale": [
          1,
          1.06,
          1
         ],
         "at": 2.6,
         "duration": 1.2,
         "repeat": -1,
         "ease": "sine.inOut"
        }
       },
       {
        "id": "deal",
        "type": "frame",
        "width": 150,
        "height": 150,
        "rotation": -12,
        "clip": false,
        "children": [
         {
          "type": "polygon",
          "sides": 14,
          "innerRadius": 0.84,
          "width": "fill",
          "height": "fill",
          "fills": "#FFE14D"
         },
         {
          "type": "text",
          "text": "-20%",
          "fontSize": 40,
          "weight": 900,
          "color": "$ink",
          "place": "center"
         }
        ],
        "in": {
         "effect": "zoom-in",
         "at": 2.0,
         "duration": 0.4
        },
        "animate": {
         "rotation": {
          "from": -200
         },
         "at": 2.0,
         "duration": 0.8,
         "ease": "back.out"
        }
       }
      ]
     }
    ]
   }
  ]
 }
}